SEARCH_READER_API_KEYS=replace-with-a-long-random-key
SEARCH_READER_JOB_DB=/data/jobs.sqlite3
SEARCH_READER_JOB_CONCURRENCY=1
SEARCH_READER_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=replace-me
# Container loopback is not the host. Use a reachable model service address.
SEARCH_READER_RWKV_BASE_URL=http://model-server:29613/v1
SEARCH_READER_RWKV_API_KEY=replace-me
SEARCH_READER_RWKV_MODEL=replace-me
SEARCH_READER_RWKV_PROTOCOL=completions
SEARCH_READER_RWKV_SUMMARY_WORKERS=4

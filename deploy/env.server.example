SEARCH_READER_RWKV_MODEL=rwkv7-g1l-7.2b-dsh-r32-merged
SEARCH_READER_RWKV_PROTOCOL=completions
SEARCH_READER_RWKV_CONTEXT_WINDOW=34304
SEARCH_READER_RWKV_SWEET_SPOT_TOKENS=9600
SEARCH_READER_RWKV_THINKING_MODE=auto
SEARCH_READER_RWKV_ADAPTER_ID=
SEARCH_READER_RWKV_ADAPTER_VERSION=
SEARCH_READER_RWKV_ADAPTER_SCALE=1.0
SEARCH_READER_RWKV_STATE_ID=
SEARCH_READER_RWKV_SUMMARY_WORKERS=32
SEARCH_READER_RWKV_FINAL_MATERIAL_CHARS=14000
SEARCH_READER_RWKV_MAX_TOKENS=2048
SEARCH_READER_RWKV_TEMPERATURE=0.3
SEARCH_READER_REVIEW_MAX_ROUNDS=1
SEARCH_READER_ROUTER_BASE_URL=http://127.0.0.1:18430/v1,http://127.0.0.1:18431/v1,http://127.0.0.1:18432/v1,http://127.0.0.1:18433/v1
SEARCH_READER_ROUTER_API_KEY=replace-me

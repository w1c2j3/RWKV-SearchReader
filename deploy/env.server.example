SEARCH_READER_API_KEYS=replace-with-a-long-random-key
SEARCH_READER_JOB_DB=/data/jobs.sqlite3
SEARCH_READER_JOB_CONCURRENCY=16
SEARCH_READER_API_MAX_CONCURRENT_REQUESTS=256
SEARCH_READER_API_QUEUE_TIMEOUT_SECONDS=120
SEARCH_READER_API_RATE_LIMIT_PER_MINUTE=1200
SEARCH_READER_SEARCH_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-replace-me
# Optional SSH forwarding to remote G1L Lightning server (used by native supervise.py)
SEARCH_READER_SSH_TARGET=
SEARCH_READER_SSH_PASSWORD=

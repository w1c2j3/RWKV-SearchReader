# Search is mandatory. Default: deepseek (/v1/tools/search + /v1/tools/fetch).
# Alternatives: tavily, wigolo, or searxng.
SEARCH_READER_SEARCH_PROVIDER=deepseek
DEEPSEEK_API_KEY=sk-your-deepseek-key
SEARCH_READER_DEEPSEEK_BASE_URL=https://api.deepseek.com
SEARCH_READER_DEEPSEEK_NEED_CONTENT=true

# Optional alternative search providers
TAVILY_API_KEY=
SEARCH_READER_WIGOLO_BASE_URL=http://127.0.0.1:3333
SEARCH_READER_WIGOLO_API_TOKEN=
SEARCH_READER_SEARXNG_BASE_URL=

# Retrieval & planning budgets
SEARCH_READER_SEARCH_MAX_RESULTS=8
SEARCH_READER_FETCH_PAGES=8
SEARCH_READER_RESEARCH_PLAN_ENABLED=true
SEARCH_READER_RESEARCH_PLAN_MAX_QUERIES=4
# 0-10 evidence review rounds; default 1 balances recall and latency.
SEARCH_READER_REVIEW_MAX_ROUNDS=1
SEARCH_READER_REVIEW_MAX_QUERIES=3
SEARCH_READER_CONVERSATION_TURNS=100

# Optional SSH port forwarding (`python deploy/forward_ssh.py`)
SEARCH_READER_SSH_TARGET=
SEARCH_READER_SSH_PASSWORD=
SEARCH_READER_SSH_FORWARDS=18430:172.17.0.1:18430,18431:172.17.0.1:18431,18432:172.17.0.1:18432,18433:172.17.0.1:18433

# Execution mode:
# - "dsh_agent": native DeepSeek Harness (`dsh-rwkv-plugin`) wire loop (`web_search`/`web_fetch`/`no_tool`, pair with NoRA adapter)
# - "pipeline": multi-stage parallel reader
# - "pi_agent": rwkv-pi-xml-continuation-v3 tool loop
SEARCH_READER_EXECUTION_MODE=dsh_agent
SEARCH_READER_PI_AGENT_MAX_TURNS=12
SEARCH_READER_PI_EPOCH_BUDGET_TOKENS=9600

# RWKV-7 G1L pure-continuation endpoints (single URL or comma-separated multi-GPU URLs).
# Supports RWKV Lightning (/v1/batch/completions, /v1/tokens/count, /v1/server/stop) and (/v1/completions).
SEARCH_READER_RWKV_BASE_URL=http://127.0.0.1:18430/v1,http://127.0.0.1:18431/v1,http://127.0.0.1:18432/v1,http://127.0.0.1:18433/v1
SEARCH_READER_RWKV_API_KEY=your-model-key
SEARCH_READER_RWKV_MODEL=rwkv7-g1l-7.2b-20261031-ctx34304
SEARCH_READER_RWKV_PROTOCOL=completions
SEARCH_READER_RWKV_CONTEXT_WINDOW=34304
# 9.6K RNN state sweet-spot token budget (ported from rwkv-pi epoch.ts)
SEARCH_READER_RWKV_SWEET_SPOT_TOKENS=9600
# Thinking mode: "auto" (OpenThink on finalize/branch_finalize, FakeThink on summarize/extract), "on", or "off"
SEARCH_READER_RWKV_THINKING_MODE=auto
# Optional Lightning NoRA adapter / StateTune bindings
SEARCH_READER_RWKV_ADAPTER_ID=
SEARCH_READER_RWKV_ADAPTER_VERSION=
SEARCH_READER_RWKV_ADAPTER_SCALE=1.0
SEARCH_READER_RWKV_STATE_ID=
SEARCH_READER_RWKV_CF_ACCESS_CLIENT_ID=
SEARCH_READER_RWKV_CF_ACCESS_CLIENT_SECRET=
SEARCH_READER_RWKV_SUMMARY_WORKERS=12
SEARCH_READER_RWKV_SUMMARY_MAX_TOKENS=1024
SEARCH_READER_RWKV_REDUCE_CHUNK_CHARS=6000
SEARCH_READER_RWKV_REDUCE_FAN_IN=4
SEARCH_READER_RWKV_FINAL_MATERIAL_CHARS=14000
SEARCH_READER_RWKV_MAX_TOKENS=2048
SEARCH_READER_RWKV_TEMPERATURE=0.3

# Optional dedicated final synthesis endpoint; blank reuses primary RWKV settings.
SEARCH_READER_RWKV_FINAL_BASE_URL=
SEARCH_READER_RWKV_FINAL_API_KEY=
SEARCH_READER_RWKV_FINAL_MODEL=
SEARCH_READER_RWKV_FINAL_PROTOCOL=completions
SEARCH_READER_RWKV_FINAL_CF_ACCESS_CLIENT_ID=
SEARCH_READER_RWKV_FINAL_CF_ACCESS_CLIENT_SECRET=

# Retrieval and API limits
SEARCH_READER_CHUNK_CHARS=2600
SEARCH_READER_CHUNK_OVERLAP_CHARS=260
SEARCH_READER_MAX_EVIDENCE_CHARS=12000
SEARCH_READER_DOCUMENT_MAX_BYTES=10000000
SEARCH_READER_DOCUMENT_PDF_MAX_BYTES=20000000
SEARCH_READER_DOCUMENT_PDF_MAX_PAGES=200
SEARCH_READER_DOCUMENT_CHUNK_CHARS=2400
SEARCH_READER_DOCUMENT_MAX_CHUNKS=12
SEARCH_READER_DOCUMENT_FULL_READ_MAX_CHUNKS=400
SEARCH_READER_REQUEST_TIMEOUT_SECONDS=45
SEARCH_READER_API_MAX_CONCURRENT_REQUESTS=4
SEARCH_READER_API_QUEUE_TIMEOUT_SECONDS=20
SEARCH_READER_API_RATE_LIMIT_PER_MINUTE=20
SEARCH_READER_MODEL_TIMEOUT_SECONDS=180
SEARCH_READER_RWKV_MAX_CALLS_PER_REQUEST=600
SEARCH_READER_API_HOST=0.0.0.0
SEARCH_READER_API_PORT=8790
SEARCH_READER_TRACE_ENABLED=1
SEARCH_READER_TRACE_RETENTION_DAYS=30
SEARCH_READER_TRACE_MAX_TOTAL_BYTES=1000000000

# Search decision router (/v1/search/decision) using G1L pure continuation
SEARCH_READER_ROUTER_BASE_URL=http://127.0.0.1:18430/v1,http://127.0.0.1:18431/v1,http://127.0.0.1:18432/v1,http://127.0.0.1:18433/v1
SEARCH_READER_ROUTER_MODEL=rwkv7-g1l-7.2b-20261031-ctx34304
SEARCH_READER_ROUTER_API_KEY=your-model-key
SEARCH_READER_ROUTER_PROTOCOL=completions
SEARCH_READER_ROUTER_TIMEOUT_SECONDS=20
SEARCH_READER_ROUTER_ADAPTER_ID=
SEARCH_READER_ROUTER_STATE_ID=
SEARCH_READER_ROUTER_CF_ACCESS_CLIENT_ID=
SEARCH_READER_ROUTER_CF_ACCESS_CLIENT_SECRET=

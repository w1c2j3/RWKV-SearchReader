# Search is mandatory. Default: Tavily. Alternatives: wigolo or searxng.
SEARCH_READER_SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
# Keep exactly one active key here. Change it manually after its quota is used.
SEARCH_READER_WIGOLO_BASE_URL=http://127.0.0.1:3333
SEARCH_READER_WIGOLO_API_TOKEN=
SEARCH_READER_SEARXNG_BASE_URL=
SEARCH_READER_SEARCH_MAX_RESULTS=10
SEARCH_READER_FETCH_PAGES=10
# Let RWKV judge scope, form answer records and decompose search queries.
SEARCH_READER_RESEARCH_PLAN_ENABLED=true
SEARCH_READER_RESEARCH_PLAN_MAX_QUERIES=4
# Audit accumulated evidence, then add up to 10 new sources per missing-evidence round.
# 0-10 evidence review rounds; the default remains two.
SEARCH_READER_REVIEW_MAX_ROUNDS=2
SEARCH_READER_REVIEW_MAX_QUERIES=3
# Keep up to 100 relevant prior turns for follow-up questions.
SEARCH_READER_CONVERSATION_TURNS=100

# RWKV G1k 13.3B OpenAI-compatible endpoint. Supply your own API credentials.
SEARCH_READER_RWKV_BASE_URL=https://api-13b.rwkvos.com/v1
SEARCH_READER_RWKV_API_KEY=your-model-key
SEARCH_READER_RWKV_MODEL=rwkv7-g1k-13.3b-20260930-ctx25600.w8a16
SEARCH_READER_RWKV_PROTOCOL=chat
# Optional Cloudflare Access service-token headers for the RWKV endpoint.
SEARCH_READER_RWKV_CF_ACCESS_CLIENT_ID=
SEARCH_READER_RWKV_CF_ACCESS_CLIENT_SECRET=
SEARCH_READER_RWKV_SUMMARY_WORKERS=10
SEARCH_READER_RWKV_SUMMARY_MAX_TOKENS=1024
# Funnel reduction: at most four inputs and 6000 rendered characters per group.
SEARCH_READER_RWKV_REDUCE_CHUNK_CHARS=6000
SEARCH_READER_RWKV_REDUCE_FAN_IN=4
# Reduce recursively until the final material fits this character budget.
SEARCH_READER_RWKV_FINAL_MATERIAL_CHARS=9000
SEARCH_READER_RWKV_MAX_TOKENS=4090
SEARCH_READER_RWKV_TEMPERATURE=0.1

# Final synthesis, conversation summaries and documents use the same G1k 13.3B.
SEARCH_READER_RWKV_FINAL_BASE_URL=https://api-13b.rwkvos.com/v1
SEARCH_READER_RWKV_FINAL_API_KEY=
SEARCH_READER_RWKV_FINAL_MODEL=rwkv7-g1k-13.3b-20260930-ctx25600.w8a16
SEARCH_READER_RWKV_FINAL_PROTOCOL=chat
SEARCH_READER_RWKV_FINAL_CF_ACCESS_CLIENT_ID=
SEARCH_READER_RWKV_FINAL_CF_ACCESS_CLIENT_SECRET=

# Retrieval and API limits
SEARCH_READER_CHUNK_CHARS=2600
SEARCH_READER_CHUNK_OVERLAP_CHARS=260
SEARCH_READER_MAX_EVIDENCE_CHARS=12000
SEARCH_READER_DOCUMENT_MAX_BYTES=10000000
SEARCH_READER_DOCUMENT_PDF_MAX_BYTES=20000000
SEARCH_READER_DOCUMENT_PDF_MAX_PAGES=200
SEARCH_READER_DOCUMENT_CHUNK_CHARS=2400
SEARCH_READER_DOCUMENT_MAX_CHUNKS=12
SEARCH_READER_DOCUMENT_FULL_READ_MAX_CHUNKS=400
SEARCH_READER_REQUEST_TIMEOUT_SECONDS=45
SEARCH_READER_API_MAX_CONCURRENT_REQUESTS=4
SEARCH_READER_API_QUEUE_TIMEOUT_SECONDS=20
SEARCH_READER_API_RATE_LIMIT_PER_MINUTE=20
SEARCH_READER_MODEL_TIMEOUT_SECONDS=180
SEARCH_READER_RWKV_MAX_CALLS_PER_REQUEST=600
SEARCH_READER_API_HOST=0.0.0.0
SEARCH_READER_API_PORT=8790
SEARCH_READER_TRACE_ENABLED=1
SEARCH_READER_TRACE_RETENTION_DAYS=30
SEARCH_READER_TRACE_MAX_TOTAL_BYTES=1000000000

# Optional dedicated model for /v1/search/decision; disabled until configured.
SEARCH_READER_ROUTER_BASE_URL=
SEARCH_READER_ROUTER_MODEL=
SEARCH_READER_ROUTER_API_KEY=local
SEARCH_READER_ROUTER_PROTOCOL=completions
SEARCH_READER_ROUTER_TIMEOUT_SECONDS=20
SEARCH_READER_ROUTER_CF_ACCESS_CLIENT_ID=
SEARCH_READER_ROUTER_CF_ACCESS_CLIENT_SECRET=
